<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SystemProgramm.Views.Controls"
        xmlns:loc="clr-namespace:SystemProgramm"
        xmlns:vm="clr-namespace:SystemProgramm.ViewModels"
        x:Class="SystemProgramm.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000"
        Height="640"
        MinWidth="800"
        MinHeight="500"
        Title="{x:Static loc:Localization.AppTitle}"
        Icon="/Assets/soft_icon.ico"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        WindowStartupLocation="CenterScreen">

    <Window.TransparencyBackgroundFallback>
        <SolidColorBrush Color="{DynamicResource SystemChromeMediumColor}" />
    </Window.TransparencyBackgroundFallback>

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">
        <controls:NavMenuView Grid.Row="0" Grid.Column="0" />

        <controls:PageHostView Grid.Row="0" Grid.Column="1" />

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="18 8"
                BorderThickness="0 1 0 0"
                Background="{DynamicResource AppNavBrush}">

            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource SystemBaseHighColor}" Opacity="0.1" />
            </Border.BorderBrush>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Classes="small"
                           Opacity="0.65"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding RightsNotice}" />

                <HyperlinkButton Grid.Column="1"
                                 Padding="0"
                                 Margin="16 0 0 0"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Content="{x:Static loc:Localization.RightsRestart}"
                                 Command="{Binding Elevate}"
                                 IsVisible="{Binding !IsAdministrator}" />
            </Grid>
        </Border>

    </Grid>
</Window>