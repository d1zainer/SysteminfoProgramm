<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SystemProgramm.Views.Converters"
        xmlns:loc="clr-namespace:SystemProgramm"
        xmlns:pages="clr-namespace:SystemProgramm.ViewModels.Pages"
        xmlns:views="clr-namespace:SystemProgramm.Views.Pages"
        xmlns:vm="clr-namespace:SystemProgramm.ViewModels"
        x:Class="SystemProgramm.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000"
        Height="640"
        MinWidth="800"
        MinHeight="500"
        Title="{x:Static loc:Localization.AppTitle}"
        Icon="/Assets/soft_icon.ico"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        WindowStartupLocation="CenterScreen">

    <Window.TransparencyBackgroundFallback>
        <SolidColorBrush Color="{DynamicResource SystemChromeMediumColor}" />
    </Window.TransparencyBackgroundFallback>

    <Window.Resources>
        <conv:SectionToIconConverter x:Key="PageIcon" />
    </Window.Resources>

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">
        <!-- Подложка под меню: там, где Mica работает, она просвечивает сквозь неё,
             а там, где система её не рисует, окно не превращается в дыру. -->
        <Border Grid.Row="0" Grid.Column="0">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource SystemChromeLowColor}" Opacity="0.85" />
            </Border.Background>

            <ListBox Padding="0 30 0 0 "
                     ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding CurrentPage}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="pages:PageViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ContentControl Template="{Binding Info.Section, Converter={StaticResource PageIcon}}"
                                            Foreground="{Binding $parent[ListBoxItem].Foreground}" />

                            <TextBlock Margin="0 0 10 0"
                                       VerticalAlignment="Center"
                                       Classes="medium"
                                       Text="{Binding Info.Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>


        <Border Grid.Row="0" Grid.Column="1">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource SystemChromeMediumColor}" />
            </Border.Background>

            <ContentControl Content="{Binding CurrentPage}">
                <ContentControl.DataTemplates>

                    <DataTemplate DataType="pages:OverviewViewModel">
                        <views:OverviewView />
                    </DataTemplate>

                    <DataTemplate DataType="pages:SectionViewModel">
                        <views:SectionView />
                    </DataTemplate>

                    <DataTemplate DataType="pages:SettingsViewModel">
                        <views:SettingsView />
                    </DataTemplate>

                    <DataTemplate DataType="pages:PageViewModel">
                        <TextBlock Margin="24"
                                   Text="{x:Static loc:Localization.PageNotImplemented}" />
                    </DataTemplate>

                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Padding="18 8"
                BorderThickness="0 1 0 0">

            <Border.Background>
                <SolidColorBrush Color="{DynamicResource SystemChromeLowColor}" Opacity="0.85" />
            </Border.Background>

            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource SystemBaseHighColor}" Opacity="0.1" />
            </Border.BorderBrush>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Classes="small"
                           Opacity="0.65"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding RightsNotice}" />

                <HyperlinkButton Grid.Column="1"
                                 Padding="0"
                                 Margin="16 0 0 0"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Content="{x:Static loc:Localization.RightsRestart}"
                                 Command="{Binding Elevate}"
                                 IsVisible="{Binding !IsAdministrator}" />
            </Grid>
        </Border>

    </Grid>
</Window>