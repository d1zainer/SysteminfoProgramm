<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:SystemProgramm.ViewModels.Charts"
             xmlns:controls="clr-namespace:SystemProgramm.Views.Controls"
             x:Class="SystemProgramm.Views.Charts.MetricChartView"
             x:DataType="charts:MetricViewModel">

    <Border Classes="card" Classes.temperature="{Binding IsTemperature}">
        <Grid RowDefinitions="Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Classes="medium"
                           Text="{Binding Title}" />

                <TextBlock Grid.Column="1"
                           Classes="medium"
                           Opacity="0.65"
                           Text="{Binding Current}" />
            </Grid>

            <controls:MetricChart Grid.Row="1"
                                  Height="140"
                                  Margin="0 14 0 0"
                                  Capacity="{Binding Capacity}"
                                  Minimum="{Binding Minimum}"
                                  Maximum="{Binding Maximum}"
                                  Values="{Binding Values}" />

        </Grid>
    </Border>

</UserControl>