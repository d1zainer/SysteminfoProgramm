<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:SystemProgramm.ViewModels.Cards"
             xmlns:pages="clr-namespace:SystemProgramm.ViewModels.Pages"
             xmlns:views="clr-namespace:SystemProgramm.Views.Cards"
             x:Class="SystemProgramm.Views.Pages.OverviewView"
             x:DataType="pages:OverviewViewModel">

    <ScrollViewer>
        <ItemsControl Margin="{StaticResource InsetLg}" ItemsSource="{Binding Cards}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="cards:OverviewCardViewModel">
                    <views:OverviewCardView Margin="{StaticResource InsetXs}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
    </ScrollViewer>

</UserControl>