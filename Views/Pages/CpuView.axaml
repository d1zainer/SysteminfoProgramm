<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:SystemProgramm.Views.Charts"
             xmlns:pages="clr-namespace:SystemProgramm.ViewModels.Pages"
             x:Class="SystemProgramm.Views.CpuView"
             x:DataType="pages:CpuViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="{Binding Headline}" />
                <TextBlock Classes="small" Opacity="0.65" Text="{Binding Detail}" />
            </StackPanel>

            <charts:MetricChartView DataContext="{Binding Load}" />
            <charts:MetricChartView DataContext="{Binding Temperature}" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
