<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:SystemProgramm.ViewModels.Charts"
             xmlns:controls="clr-namespace:SystemProgramm.Views.Controls"
             xmlns:conv="clr-namespace:SystemProgramm.Views.Converters"
             xmlns:loc="clr-namespace:SystemProgramm"
             xmlns:models="clr-namespace:SystemProgramm.Models"
             xmlns:pages="clr-namespace:SystemProgramm.ViewModels.Pages"
             x:Class="SystemProgramm.Views.Pages.SectionView"
             x:DataType="pages:SectionViewModel">

    <UserControl.Resources>
        <conv:EqualsConverter x:Key="Same" />
        <conv:ListHalfConverter x:Key="Half" />

        <DataTemplate x:Key="DetailRow" DataType="pages:DetailRowViewModel">
            <Grid Margin="0 0 0 8" ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0"
                           Margin="0 0 8 0"
                           Opacity="0.65"
                           VerticalAlignment="Top"
                           Text="{Binding Name, StringFormat='{}{0}:'}" />

                <TextBlock Grid.Column="1"
                           TextWrapping="Wrap"
                           Text="{Binding Value, TargetNullValue=—}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource InsetMd}" RowDefinitions="2*,*" RowSpacing="{StaticResource GapMd}">

        <Border Grid.Row="0"
                Classes="card"
                Classes.temperature="{Binding SelectedMetric.Kind,
                                              Converter={StaticResource Same},
                                              ConverterParameter={x:Static models:MetricKind.Temperature}}"
                Classes.network="{Binding SelectedMetric.Kind,
                                          Converter={StaticResource Same},
                                          ConverterParameter={x:Static models:MetricKind.Network}}">

            <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <ComboBox Grid.Column="1"
                             Classes="chart"
                             MinWidth="140"
                             VerticalAlignment="Center"
                             IsVisible="{Binding HasSwitch}"
                             ItemsSource="{Binding Charts}"
                             SelectedItem="{Binding SelectedMetric}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="charts:MetricViewModel">
                                <TextBlock Classes="small" Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <controls:MetricChart Grid.Row="1"
                                      Margin="{StaticResource BlockGap}"
                                      Capacity="{Binding SelectedMetric.Capacity}"
                                      Minimum="{Binding SelectedMetric.Minimum}"
                                      Maximum="{Binding SelectedMetric.Maximum}"
                                      Unit="{Binding SelectedMetric.Unit}"
                                      WindowLabel="{Binding SelectedMetric.Window}"
                                      NowLabel="{x:Static loc:Localization.ChartNow}"
                                      Values="{Binding SelectedMetric.Values}"
                                      SecondaryValues="{Binding SelectedMetric.SecondaryValues}" />

            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card">
            <ScrollViewer>
                <Grid ColumnDefinitions="*,*">
                    <ItemsControl Grid.Column="0"
                                  Margin="0 0 24 0"
                                  ItemTemplate="{StaticResource DetailRow}"
                                  ItemsSource="{Binding Details, Converter={StaticResource Half}, ConverterParameter=first}" />

                    <ItemsControl Grid.Column="1"
                                  ItemTemplate="{StaticResource DetailRow}"
                                  ItemsSource="{Binding Details, Converter={StaticResource Half}, ConverterParameter=second}" />
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>