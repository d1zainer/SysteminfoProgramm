<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SystemProgramm"
             xmlns:pages="clr-namespace:SystemProgramm.ViewModels.Pages"
             x:Class="SystemProgramm.Views.Pages.AboutView"
             x:DataType="pages:AboutViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="{x:Static loc:Localization.AppTitle}" />
                <TextBlock Classes="small" Opacity="0.65" Text="{Binding Version}" />
            </StackPanel>

            <TextBlock Classes="title" Text="{x:Static loc:Localization.AboutLicenses}" />

            <StackPanel Spacing="6">
                <TextBlock Classes="medium" Text="Onest — SIL Open Font License 1.1" />
                <TextBlock TextWrapping="Wrap" Text="{Binding OnestLicense}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="medium" Text="Lucide — ISC / MIT" />
                <TextBlock TextWrapping="Wrap" Text="{Binding LucideLicense}" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="medium" Text="LibreHardwareMonitorLib — Mozilla Public License 2.0" />
                <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Localization.AboutLhmNotice}" />
                <HyperlinkButton Padding="0"
                                 Content="github.com/LibreHardwareMonitor/LibreHardwareMonitor"
                                 NavigateUri="https://github.com/LibreHardwareMonitor/LibreHardwareMonitor" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>