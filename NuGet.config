<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Пакеты берём только с nuget.org. <clear /> отсекает приватный фид,
       прописанный глобально: доступа к нему нет, и restore из-за него падает. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>